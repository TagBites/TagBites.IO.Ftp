<Project Sdk="Microsoft.NET.Sdk">

  <!-- Targets -->
  <PropertyGroup>
    <TargetFramework>netstandard2.0</TargetFramework>
    <RootNamespace>TagBites.IO.Ftp</RootNamespace>
  </PropertyGroup>

  <!-- Build -->
  <PropertyGroup>
    <GeneratePackageOnBuild>true</GeneratePackageOnBuild>
  </PropertyGroup>

  <!-- Package info -->
  <PropertyGroup>
    <Description>FTP/FTPS file system support for TagBites.IO, built on FluentFTP. Browse, read, write and sync a remote FTP server through the same FileSystem API used for local disk and other storages.</Description>
    <PackageTags>file;files;filesystem;storage;sync;ftp;ftps</PackageTags>
    <PackageProjectUrl>https://www.tagbites.com/io</PackageProjectUrl>
  </PropertyGroup>

  <!-- References -->
  <ItemGroup>
    <ProjectReference Include="$(SolutionDir)\src\TagBites.IO\TagBites.IO.csproj" Condition="$(SolutionName.EndsWith('-dev'))" />
    <PackageReference Include="TagBites.IO" Version="2.0.0" Condition="!$(SolutionName.EndsWith('-dev'))" />
    <PackageReference Include="FluentFTP" Version="54.2.0" />
  </ItemGroup>

</Project>
